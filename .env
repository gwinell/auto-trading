# OKX Trading Bot Configuration

# OKX API Credentials (required for live trading)
OKX_API_KEY=your_api_key_here
OKX_API_SECRET=your_api_secret_here
OKX_PASSPHRASE=your_passphrase_here

# OKX Environment (true for Demo/Sandbox, false for Live/Production)
# Set to true if using demo account keys, false for live account keys
OKX_SANDBOX=true

# Strategy Settings (optional - defaults are used if not specified)
# SYMBOL=BTC/USDT
# TIMEFRAME=5m
# LEVERAGE=1
# INITIAL_CAPITAL=2000
# POSITION_SIZE_PCT=100

# UT Bot Settings
# KEY_VALUE=2.0
# ATR_PERIOD=10

# DEMA Settings
# DEMA_LEN=21

# Early Exit Settings
# RR_MULTIPLIER=1.0
# USE_DEMA_EXIT=true
# USE_RSI_EXIT=true
# RSI_LEN=14
# RSI_OVERBOUGHT=70
# RSI_OVERSOLD=30

# FVG & Momentum Settings
# USE_FVG_FILTER=true
# USE_ADX_FILTER=true
# ADX_LEN=14
# ADX_THRESH=20
# BODY_RATIO=0.6

# Filters
# HTF_FILTER_ON=false
# HTF_TIMEFRAME=60m
# VOL_FILTER_ON=false
# VOL_LEN=20
